[Unit]
Description=Deck Input Lift focused input visibility
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/deck-input-lift/native/focus_guard.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
