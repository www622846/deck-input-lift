[Unit]
Description=Experimental Hangul composition bridge for the existing Steam keyboard
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/deck-steam-hangul/bridge.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
